// Version information for QuillCnv.cnv. build.cmd generates version.h from Directory.Build.props.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QUILL_VERSION_COMMA
 PRODUCTVERSION QUILL_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hugh Cumper"
            VALUE "FileDescription", "Sinclair QL Quill import converter for Microsoft Word"
            VALUE "FileVersion", QUILL_VERSION_STR
            VALUE "InternalName", "QuillCnv"
            VALUE "LegalCopyright", "Copyright (c) 2026 Hugh Cumper. MIT License."
            VALUE "OriginalFilename", "QuillCnv.cnv"
            VALUE "ProductName", "QuillToDocx"
            VALUE "ProductVersion", QUILL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
